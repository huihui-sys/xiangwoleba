{
    "name": "xiangwoleba",
    "version": "1.0.0",
    "private": true,
    "description": "想我了吧 —— 温柔的自用情感支持小应用（网页 + Android 打包）",
    "scripts": {
        "check": "node scripts/check.js",
        "selftest": "node scripts/selftest.js",
        "test": "node scripts/check.js && node scripts/selftest.js",
        "www": "node scripts/build-www.js",
        "serve": "node scripts/serve.js",
        "cap:add": "npx cap add android",
        "cap:sync": "npm run www && npx cap sync android",
        "apk": "npm run cap:sync && node scripts/patch-android.js && cd android && gradlew.bat assembleDebug"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/app": "^8.1.1",
        "@capacitor/core": "^8.5.2",
        "@capacitor/local-notifications": "^8.3.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.2"
    }
}
